# ==============================================================================
# AI Tech Consultant - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to create your local .env file:
#    cp .env.example .env
# 2. To run offline with zero external API dependencies, keep LLM_PROVIDER=mock
# 3. To run with live AI models, set LLM_PROVIDER=claude or LLM_PROVIDER=gemini
#    and insert your respective API key below.
# ==============================================================================

# --- LLM Provider Configuration ---
# Supported providers: "claude" (primary), "gemini" (fallback/comparison), "mock" (offline/tests)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Model Selection ---
PRIMARY_MODEL=claude-haiku-5-5
COMPARISON_MODEL=gemini-2.5-flash
SONNET_MODEL=claude-sonnet-5-5

# --- Task 1: Knowledge Brain ---
T1_PORT=8000
T1_UI_PORT=8501
KB_BASE_URL=http://localhost:8000/v1
KB_API_KEY=kb_secret_dev_key_2026
T1_DB_PATH=./task1.db
CHROMA_PERSIST_DIR=./chroma_db
CRAWL_DELAY_SECONDS=1.0
CRAWL_MAX_CONCURRENT=2

# --- Task 2: Inbox Agent ---
T2_PORT=3000
NEXT_PUBLIC_KB_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_KB_API_KEY=kb_secret_dev_key_2026
T2_DB_PATH=./inbox.db

# --- Task 3: Meeting -> Scope ---
T3_UI_PORT=8502
T3_HOURLY_RATE=125.0
T3_CURRENCY=USD
T3_DB_PATH=./scope.db
